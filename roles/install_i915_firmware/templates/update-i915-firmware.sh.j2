#!/usr/bin/env bash
# {{ ansible_managed }}
set -euo pipefail

firmware_index_url="https://www.kernel.org/pub/linux/kernel/firmware/"
state_file="/var/lib/i915-firmware/version"
firmware_dest="/lib/firmware"

mkdir -p "$(dirname "$state_file")"

latest=$(curl -fsSL "$firmware_index_url" | grep -oE 'linux-firmware-[0-9]{8}' | sort | tail -n1)
if [ -z "$latest" ]; then
    echo "Could not determine latest firmware version" >&2
    exit 1
fi

current=""
[ -f "$state_file" ] && current=$(cat "$state_file")

if [ "$current" = "$latest" ]; then
    echo "i915 firmware already at latest ($latest)"
    exit 0
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

curl -fsSL "${firmware_index_url}${latest}.tar.gz" | tar -xz -C "$tmpdir" "${latest}/i915"
cp -a "$tmpdir/$latest/i915" "$firmware_dest/"
echo "$latest" > "$state_file"
update-initramfs -u -k all

echo "i915 firmware updated to $latest"

if [ "${AUTO_REBOOT:-0}" = "1" ]; then
    if [ -f /var/run/reboot-required ]; then
        echo "Reboot already pending from another source (e.g. unattended-upgrades) - leaving it to that, not rebooting now"
        exit 0
    fi
    echo "Rebooting to load new i915 firmware"
    systemctl reboot
    exit 0
fi

exit 10
